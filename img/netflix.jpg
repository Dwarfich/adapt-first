sh","value":"turkish","label":"Turkish","nativeTranslation":"Türkçe"},{"id":"1yQmXamnuJrNx0TlA1LQHM","code":"vi","obelixKey":"common-language-vietnamese","value":"vietnamese","label":"Vietnamese","nativeTranslation":"Tiếng Việt"},{"id":"77SrwRfce9DpSsj9P0FNDm","code":"zh-hans","obelixKey":"common-language-chinese-simplified","value":"chinese-simplified","label":"Chinese (Simplified)","nativeTranslation":"简体中文"},{"id":"1rmFgSPcDyDtlt7b20n6YR","code":"zh-hant","obelixKey":"common-language-chinese-traditional","value":"chinese-traditional","label":"Chinese (Traditional)","nativeTranslation":"繁體中文"}],"currentLanguage":{"id":"3mMtZ4anWEqYmmyJ6l6CQb","code":"en","obelixKey":"common-language-english","value":"english","label":"English","nativeTranslation":"English"},"navOpen":false,"filterOpen":false,"pageProps":{"currentLanguage":"en","countryCode":"kz","namespacesRequired":["press-site-common","press-site-error","press-site-article"],"article":{"body":{"content":[{"content":[{"marks":[{"type":"italic"}],"nodeType":"text","value":"Updated May 23, 2024: Since introducing our first report, we’ve made important improvements — adding runtime and views (total hours viewed divided by runtime) and separating films and series. This mirrors our weekly "},{"content":[{"marks":[{"type":"underline"},{"type":"italic"}],"nodeType":"text","value":"Top 10"}],"data":{"uri":"https://www.netflix.com/tudum/top10/"},"nodeType":"hyperlink"},{"marks":[{"type":"italic"}],"nodeType":"text","value":" and "},{"content":[{"marks":[{"type":"underline"},{"type":"italic"}],"nodeType":"text","value":"Most Popular"}],"data":{"uri":"https://www.netflix.com/tudum/top10/most-popular?week=2023-12-03"},"nodeType":"hyperlink"},{"marks":[{"type":"italic"}],"nodeType":"text","value":" lists. See our report for the second half of 2023 "},{"content":[{"marks":[{"type":"underline"},{"type":"italic"}],"nodeType":"text","value":"here"}],"data":{"uri":"https://about.netflix.com/news/what-we-watched-the-second-half-of-2023"},"nodeType":"hyperlink"},{"marks":[{"type":"italic"}],"nodeType":"text","value":"."}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"Since launching our weekly "},{"content":[{"marks":[{"type":"underline"}],"nodeType":"text","value":"Top 10"}],"data":{"uri":"https://www.netflix.com/tudum/top10/"},"nodeType":"hyperlink"},{"marks":[],"nodeType":"text","value":" and "},{"content":[{"marks":[{"type":"underline"}],"nodeType":"text","value":"Most Popular"}],"data":{"uri":"https://www.netflix.com/tudum/top10/most-popular?week=2023-12-03"},"nodeType":"hyperlink"},{"marks":[],"nodeType":"text","value":" lists in 2021, Netflix has provided more information about what people are watching than any other streamer except YouTube. And now we believe it’s time to go further. "}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"Starting today we will publish "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"What We Watched: A Netflix Engagement Report "},{"marks":[],"nodeType":"text","value":"twice a year. This is a comprehensive report of what people watched on Netflix over a six month period[1], including: "}],"nodeType":"paragraph"},{"content":[{"content":[{"content":[{"marks":[],"nodeType":"text","value":"Hours viewed for every title — original and licensed — watched for over 50,000 hours"},{"marks":[{"type":"superscript"}],"nodeType":"text","value":"2"},{"marks":[],"nodeType":"text","value":"; "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The premiere date[3] for any Netflix TV series or film; and "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"Whether a title was available globally. "}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"content":[{"marks":[],"nodeType":"text","value":"In total, this report covers more than 18,000 titles — representing 99% of all viewing on Netflix — and nearly 100 billion hours viewed. "}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"Over 60% of Netflix titles released between January and June 2023 appeared on our weekly Top 10 lists. So while this report is broader in scope, the trends reflected in it are very similar to those in the Top 10 lists, including: "}],"nodeType":"paragraph"},{"content":[{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The strength of returning favorites like "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Ginny \u0026 Georgia"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Alice in Borderland"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"The Marked Heart"},{"marks":[],"nodeType":"text","value":","},{"marks":[{"type":"italic"}],"nodeType":"text","value":" Outer Banks"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"You"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Queen Charlotte: A Bridgerton Story, XO Kitty "},{"marks":[],"nodeType":"text","value":"and film sequels "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Murder Mystery 2"},{"marks":[],"nodeType":"text","value":" and "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Extraction 2"},{"marks":[],"nodeType":"text","value":"; "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The popularity of new series like "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"The Night Agent"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"The Diplomat"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Beef"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"The Glory"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Alpha Males"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"FUBAR "},{"marks":[],"nodeType":"text","value":"and "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Fake Profile, "},{"marks":[],"nodeType":"text","value":"which generate huge audiences and fandoms; "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The size of the audience of our films across every genre including "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"The Mother"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Luther: The Fallen Sun"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"You People"},{"marks":[],"nodeType":"text","value":", "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"AKA, ¡Que viva México! "},{"marks":[],"nodeType":"text","value":"and "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"Hunger"},{"marks":[],"nodeType":"text","value":"; "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The enthusiasm for non-English stories, which generated 30% of all viewing; "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The staying power of titles on Netflix, which extends well beyond their premieres. "},{"marks":[{"type":"italic"}],"nodeType":"text","value":"All Quiet on the Western Front"},{"marks":[],"nodeType":"text","value":", for example, debuted in October 2022 and generated 80M hours viewed between January and June; and "}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"The demand for older, licensed titles, which generates tremendous value for our members and for rights holders.  "}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"content":[{"marks":[],"nodeType":"text","value":"When reading the report it’s important to remember:"}],"nodeType":"paragraph"},{"content":[{"content":[{"content":[{"marks":[],"nodeType":"text","value":"Success on Netflix comes in all shapes and sizes, and is not determined by hours viewed alone. We have enormously successful movies and TV shows with both lower and higher hours viewed. It’s all about whether a movie or TV show thrilled its audience — and the size of that audience relative to the economics of the title; and"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"content":[{"content":[{"marks":[],"nodeType":"text","value":"To compare between titles it’s best to use our weekly Top 10 and Most Popular lists, which take into account run times and premiere dates. "}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"content":[{"marks":[],"nodeType":"text","value":"This is a big step forward for Netflix and our industry. We believe the viewing information in this report — combined with our weekly Top 10 and Most Popular lists — will give creators and our industry deeper insights into our audiences, and what resonates with them. "}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"Download the report "},{"content":[{"marks":[{"type":"underline"}],"nodeType":"text","value":"here"}],"data":{"uri":"https://assets.ctfassets.net/4cd45et68cgf/1HyknFM84ISQpeua6TjM7A/97a0a393098937a8f29c9d29c48dbfa8/What_We_Watched_A_Netflix_Engagement_Report_2023Jan-Jun.xlsx"},"nodeType":"hyperlink"},{"marks":[],"nodeType":"text","value":"."}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"See below for the video from our call with reporters."}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":""},{"content":[],"data":{"createdAt":"2023-12-12T23:01:08.067Z","embedLink":"https://www.youtube.com/watch?v=2iu_I72HjeM","id":"4Zr39J4A0s99CHp0HZAK2F","title":"Engagement Report Video Call","updatedAt":"2023-12-12T23:01:08.067Z"},"nodeType":"embedded-entry-inline"},{"marks":[],"nodeType":"text","value":""}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"[footnote:1] January - June 2023."}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"[footnote:2] The report is rounded to 100,000 hours viewed."}],"nodeType":"paragraph"},{"content":[{"marks":[],"nodeType":"text","value":"[footnote:3] In Pacific time. "}],"nodeType":"paragraph"}],"nodeType":"document"},"categories":[{"value":"entertainment","label":"Entertainment","id":"3SGbaxYYG5U05Z0G4piPV7"}],"createdAt":"2023-12-12T19:10:25.107Z","heroGallery":[],"heroImage":{"alt":"Logo - Header","description":null,"primaryThumbnail":"//images.ctfassets.net/4cd45et68cgf/6wHlMkLFTfKk3cQrTYnVLL/bdbbd0da407283d0833aa4575b4e81dd/Netflix_LinkdinHeader_N_Texture_5.png?w=552\u0026h=367","secondaryThumbnail":"//images.ctfassets.net/4cd45et68cgf/6wHlMkLFTfKk3cQrTYnVLL/bdbbd0da407283d0833aa4575b4e81dd/Netflix_LinkdinHeader_N_Texture_5.png?w=360\u0026h=239","smallThumbnail":"//images.ctfassets.net/4cd45et68cgf/6wHlMkLFTfKk3cQrTYnVLL/bdbbd0da407283d0833aa4575b4e81dd/Netflix_LinkdinHeader_N_Texture_5.png?w=288\u0026h=191","url":"//images.ctfassets.net/4cd45et68cgf/6wHlMkLFTfKk3cQrTYnVLL/bdbbd0da407283d0833aa4575b4e81dd/Netflix_LinkdinHeader_N_Texture_5.png?w=2560"},"id":"3Ue2REyXg3pj9GMxBogyRR","isEnglishLocaleViewable":true,"isUnlisted":false,"locations":[{"value":"global","label":"Global","countryCode":"glo","id":"ArmIlSEmeFUuUbV4AuRlr"}],"meta":{"createdAt":"2023-12-12T19:10:25.107Z","id":"3Ue2REyXg3pj9GMxBogyRR","updatedAt":"2024-05-28T18:11:11.435Z"},"pageMetaDescription":"Starting today, Netflix will publish this report twice a year. This is a comprehensive look at what people watched on Netflix over a six month period.","slug":"what-we-watched-a-netflix-engagement-report","title":"What We Watched: A Netflix Engagement Report","updatedAt":"2024-05-28T18:11:11.435Z","rawPublishedDate":"2023-12-12T11:30-08:00","publishedDate":"12 December 2023","heroImageOrientation":"landscape"},"statusCode":200}},"page":"/news/[slug]","query":{"utm_source":"substack","utm_medium":"email","slug":"what-we-watched-a-netflix-engagement-report"},"buildId":"NvsSCGajAtenw01kLsdkO","runtimeConfig":{"NAVER_CONTENT_TOKEN":"826f9c5b4af65227645b3e4cfe43d164c1c0643a","FULL_URL":"https://about.netflix.com","services":{"BASE_API_URL":"http://localhost:7101/api","datastore":{"API_URL":"http://localhost:7101/api/data"}}},"isFallback":false,"isExperimentalCompile":false,"gip":true,"appGip":true,"locale":"en","locales":["default","en","fr","es","es_es","de","it","ja","pt_br","pt_pt","ko","zh_cn","zh_tw","ar","tr","pl","th","ro","el","id","ru","vi"],"defaultLocale":"default","scriptLoader":[]}</script></body></html>